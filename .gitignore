node_modules/
dist/
*.log
.vite/
# Playwright MCP screenshots and logs (debugging only).
.playwright-mcp/

# Local reference image (third-party character art, not licensed for the repo)
avatar.png

# Local decor images that override the committed ones (e.g. your own print on the desk mug).
src/assets/local/

# Your own recordings stay local by default (licenses vary); remove these lines to commit CC0 files.
public/audio/**/*.ogg
public/audio/**/*.oga
public/audio/**/*.opus
public/audio/**/*.mp3
public/audio/**/*.wav
public/audio/**/*.m4a
public/audio/**/*.aac
public/audio/**/*.flac
public/audio/**/*.webm
# ...except the recordings shipped with the app (licensed for redistribution, see README).
!public/audio/library/*.mp3
!public/audio/library/*.ogg
!public/audio/library/*.opus
!public/audio/library/*.m4a

# Local settings (e.g. VITE_GOOGLE_CLIENT_ID for the Drive sync).
.env.local
.env.*.local

# Editor and stray backup copies.
*.bak
